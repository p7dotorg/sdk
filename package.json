{
  "name": "@p7/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for paper7 — arXiv/PubMed research as typed Effect services",
  "module": "./src/index.ts",
  "main": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.58",
    "effect": "4.0.0-beta.58",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.58",
    "@types/bun": "latest",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@effect/platform-node": "4.0.0-beta.58",
    "effect": "4.0.0-beta.58"
  }
}
